generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model so `prisma migrate dev` has something to generate an
// initial migration from. Replace once real product schema work starts.
model Placeholder {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
}
